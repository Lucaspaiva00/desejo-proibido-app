{
  "expo": {
    "name": "Desejo Proibido",
    "slug": "desejo-proibido-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "desejoproibidoapp",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.desejoproibido.app",
      "supportsTablet": false,
      "buildNumber": "2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.desejoproibido.app",
      "versionCode": 5
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-web-browser",
      "expo-notifications",
      "expo-dev-client",
      ["expo-audio", { "microphonePermission": "Permitir a gravação de mensagens de áudio." }],
      ["expo-location", { "locationWhenInUsePermission": "Permitir calcular distâncias aproximadas entre perfis." }],
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Permitir que o Desejo Proibido acesse sua câmera para lives e chamadas de vídeo.",
          "microphonePermission": "Permitir que o Desejo Proibido acesse seu microfone para mensagens de áudio, lives e chamadas de vídeo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "androidStatusBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    }
  }
}
